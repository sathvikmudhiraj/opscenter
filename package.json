{
  "name": "opscenter",
  "version": "1.0.0",
  "private": true,
  "description": "OpsCenter enterprise PC support and ticket management system",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:concurrently": "concurrently \"npm run dev --workspace @opscenter/frontend\" \"npm run dev --workspace @opscenter/backend\"",
    "dev:frontend": "npm run dev --workspace @opscenter/frontend",
    "dev:backend": "npm run dev --workspace @opscenter/backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "start": "node scripts/start.js",
    "start:frontend": "npm run start --workspace frontend",
    "start:backend": "npm run start --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
